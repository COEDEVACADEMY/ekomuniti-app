{
  "expo": {
    "name": "ekomunitiapp",
    "slug": "ekomunity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.jpeg",
    "scheme": "ekomunitiapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/images/logo.jpeg"
      },
      "package": "com.coedevtech.ekomunitiapp"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/logo.jpeg"
    },
    "plugins": [
      "expo-router",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "fc4bd2a4-de43-415c-aebb-de12bf1a3b58"
      }
    },
    "owner": "dev.fikri"
  }
}
